    <field name="data" class="java.time.LocalDate"/>
    <field name="produto.nome" class="java.lang.String"/>
    <field name="volumeDisponivel" class="java.math.BigDecimal"/>
    <field name="totalRecebido" class="java.math.BigDecimal"/>
    <field name="totalVendasDia" class="java.math.BigDecimal"/>
    <field name="estoqueEscritural" class="java.math.BigDecimal"/>
    <field name="estoqueFechamento" class="java.math.BigDecimal"/>
    <field name="perdasGanhos" class="java.math.BigDecimal"/>
    <field name="valorVendasDia" class="java.math.BigDecimal"/>
    <field name="valorAcumuladoMes" class="java.math.BigDecimal"/>
    <field name="observacoes" class="java.lang.String"/>

    <variable name="EstoqueAbertura" class="java.math.BigDecimal">
        <variableExpression><![CDATA[
            $F{volumeDisponivel}.subtract($F{totalRecebido})
        ]]></variableExpression>
    </variable>

    <variable name="VariacaoPercentual" class="java.math.BigDecimal">
        <variableExpression><![CDATA[
            ($F{volumeDisponivel} != null && $F{volumeDisponivel}.compareTo(java.math.BigDecimal.ZERO) != 0) ?
            $F{perdasGanhos}.abs().divide($F{volumeDisponivel}, 4, java.math.RoundingMode.HALF_UP).multiply(new java.math.BigDecimal(100)) :
            java.math.BigDecimal.ZERO
        ]]></variableExpression>
    </variable>

