<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sub_medicoes_tanque" pageWidth="555" pageHeight="130" columnWidth="555"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">

    <style name="base" isDefault="true" fontName="Helvetica" fontSize="9"/>
    <style name="header" fontName="Helvetica" fontSize="9" isBold="true" mode="Opaque" backcolor="#DEDEDE">
        <box><pen lineWidth="0.5"/></box>
    </style>
    <style name="cell" fontName="Helvetica" fontSize="9">
        <box><pen lineWidth="0.5"/></box>
    </style>
    <style name="num" style="cell" pattern="#,##0.00' L'">
        <paragraph textAlignment="Right"/>
    </style>
    <field name="tanque.numero" class="java.lang.String"/>
    <field name="estoqueAbertura" class="java.math.BigDecimal"/>
    <field name="estoqueFechamentoFisico" class="java.math.BigDecimal"/>
    <variable name="TotalFechamento" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{estoqueFechamentoFisico}]]></variableExpression>
    </variable>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="120" height="20" style="header"/>
                <text><![CDATA[9) Nº Tanque]]></text>
            </staticText>
            <staticText>
                <reportElement x="120" y="0" width="180" height="20" style="header"/>
                <text><![CDATA[Estoque Abertura (L)]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="0" width="255" height="20" style="header"/>
                <text><![CDATA[9) Fechamento Físico (L)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="120" height="18" style="cell"/>
                <textFieldExpression><![CDATA[$F{tanque.numero}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00' L'">
                <reportElement x="120" y="0" width="180" height="18" style="num"/>
                <textFieldExpression><![CDATA[$F{estoqueAbertura}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00' L'">
                <reportElement x="300" y="0" width="255" height="18" style="num"/>
                <textFieldExpression><![CDATA[$F{estoqueFechamentoFisico}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <columnFooter>
        <band height="18">
            <staticText>
                <reportElement x="300" y="0" width="160" height="18" style="header"/>
                <text><![CDATA[9.1) Somatório]]></text>
            </staticText>
            <textField pattern="#,##0.00' L'">
                <reportElement x="460" y="0" width="95" height="18" style="num"/>
                <textFieldExpression><![CDATA[$V{TotalFechamento} == null ? java.math.BigDecimal.ZERO : $V{TotalFechamento}]]></textFieldExpression>
            </textField>
        </band>
    </columnFooter>
</jasperReport>
