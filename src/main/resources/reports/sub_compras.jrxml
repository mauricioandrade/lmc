<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sub_compras"
              pageWidth="555" pageHeight="200"
              columnWidth="555"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail"
              uuid="11111111-1111-1111-1111-111111111111">

    <property name="net.sf.jasperreports.default.font.name" value="DejaVu Sans"/>

    <style name="base" isDefault="true" fontName="DejaVu Sans" fontSize="8" isPdfEmbedded="true"/>
    <style name="header" style="base" isBold="true" mode="Opaque" backcolor="#E0E0E0">
        <box><pen lineWidth="0.5"/></box>
    </style>
    <style name="cell" style="base">
        <box><pen lineWidth="0.5"/></box>
    </style>
    <style name="cellRight" style="cell">
        <paragraph rightIndent="3"/>
    </style>

    <parameter name="SUBTITLE" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Volume Recebido no dia (em litros)"]]></defaultValueExpression>
    </parameter>

    <field name="numeroNotaFiscal" class="java.lang.String"/>
    <field name="fornecedor" class="java.lang.String"/>
    <field name="volumeLitros" class="java.math.BigDecimal"/>
    <field name="temperaturaMedia" class="java.math.BigDecimal"/>
    <field name="densidade" class="java.math.BigDecimal"/>

    <variable name="totalVolume" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{volumeLitros}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <columnHeader>
        <band height="28">
            <textField>
                <reportElement x="0" y="0" width="555" height="12" style="base" uuid="22222222-2222-2222-2222-222222222222"/>
                <textElement><font isBold="true" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{SUBTITLE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="14" width="80" height="14" style="header" uuid="33333333-3333-3333-3333-333333333333"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[NF/Ticket]]></text>
            </staticText>

            <staticText>
                <reportElement x="80" y="14" width="180" height="14" style="header" uuid="44444444-4444-4444-4444-444444444444"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Fornecedor]]></text>
            </staticText>

            <staticText>
                <reportElement x="260" y="14" width="80" height="14" style="header" uuid="55555555-5555-5555-5555-555555555555"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Volume (L)]]></text>
            </staticText>

            <staticText>
                <reportElement x="340" y="14" width="100" height="14" style="header" uuid="66666666-6666-6666-6666-666666666666"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Temp. Média (°C)]]></text>
            </staticText>

            <staticText>
                <reportElement x="440" y="14" width="115" height="14" style="header" uuid="77777777-7777-7777-7777-777777777777"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Densidade (kg/m³)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="14">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="80" height="14" style="cell" uuid="88888888-8888-8888-8888-888888888888"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{numeroNotaFiscal}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="80" y="0" width="180" height="14" style="cell" uuid="99999999-9999-9999-9999-999999999999"/>
                <box leftPadding="3"/>
                <textFieldExpression><![CDATA[$F{fornecedor}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="260" y="0" width="80" height="14" style="cellRight" uuid="aaaaaaa1-aaaa-aaaa-aaaa-aaaaaaaaaaa1"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{volumeLitros}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.0" isBlankWhenNull="true">
                <reportElement x="340" y="0" width="100" height="14" style="cellRight" uuid="aaaaaaa2-aaaa-aaaa-aaaa-aaaaaaaaaaa2"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{temperaturaMedia}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.000" isBlankWhenNull="true">
                <reportElement x="440" y="0" width="115" height="14" style="cellRight" uuid="aaaaaaa3-aaaa-aaaa-aaaa-aaaaaaaaaaa3"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{densidade}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <columnFooter>
        <band height="14">
            <staticText>
                <reportElement x="0" y="0" width="260" height="14" style="header" uuid="bbbbbbb1-bbbb-bbbb-bbbb-bbbbbbbbbbb1"/>
                <box rightPadding="5"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[TOTAL RECEBIDO:]]></text>
            </staticText>

            <textField pattern="#,##0.00">
                <reportElement x="260" y="0" width="80" height="14" style="header" uuid="bbbbbbb2-bbbb-bbbb-bbbb-bbbbbbbbbbb2"/>
                <box rightPadding="3"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{totalVolume}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="340" y="0" width="215" height="14" style="header" uuid="bbbbbbb3-bbbb-bbbb-bbbb-bbbbbbbbbbb3"/>
                <text><![CDATA[]]></text>
            </staticText>
        </band>
    </columnFooter>

    <noData>
        <band height="42">
            <textField>
                <reportElement x="0" y="0" width="555" height="12" style="base" uuid="ccccccc1-cccc-cccc-cccc-ccccccccccc1"/>
                <textElement><font isBold="true" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{SUBTITLE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="14" width="80" height="14" style="header" uuid="ccccccc2-cccc-cccc-cccc-ccccccccccc2"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[NF/Ticket]]></text>
            </staticText>

            <staticText>
                <reportElement x="80" y="14" width="180" height="14" style="header" uuid="ccccccc3-cccc-cccc-cccc-ccccccccccc3"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Fornecedor]]></text>
            </staticText>

            <staticText>
                <reportElement x="260" y="14" width="80" height="14" style="header" uuid="ccccccc4-cccc-cccc-cccc-ccccccccccc4"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Volume (L)]]></text>
            </staticText>

            <staticText>
                <reportElement x="340" y="14" width="100" height="14" style="header" uuid="ccccccc5-cccc-cccc-cccc-ccccccccccc5"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Temp. Média (°C)]]></text>
            </staticText>

            <staticText>
                <reportElement x="440" y="14" width="115" height="14" style="header" uuid="ccccccc6-cccc-cccc-cccc-ccccccccccc6"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Densidade (kg/m³)]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="28" width="555" height="14" style="cell" uuid="ccccccc7-cccc-cccc-cccc-ccccccccccc7"/>
                <textElement textAlignment="Center"><font isItalic="true"/></textElement>
                <text><![CDATA[Nenhuma compra registrada neste dia]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
