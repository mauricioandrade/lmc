<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sub_vendas_bico" pageWidth="555" pageHeight="170" columnWidth="555"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
    <style name="base" isDefault="true" fontName="Helvetica" fontSize="9"/>
    <style name="header" style="base" isBold="true" mode="Opaque" backcolor="#DEDEDE">
        <box><pen lineWidth="0.5"/></box>
    </style>
    <style name="cell"><box><pen lineWidth="0.5"/></box></style>
    <style name="num" style="cell" pattern="#,##0.00' L'">
        <paragraph textAlignment="Right"/>
    </style>
    <field name="bico.tanque.numero" class="java.lang.String"/>
    <field name="bico.numero" class="java.lang.String"/>
    <field name="encerranteFechamento" class="java.math.BigDecimal"/>
    <field name="encerranteAbertura" class="java.math.BigDecimal"/>
    <field name="afericoes" class="java.math.BigDecimal"/>
    <field name="vendasBico" class="java.math.BigDecimal"/>

    <variable name="TotalVendasBico" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{vendasBico}]]></variableExpression>
    </variable>

    <columnHeader>
        <band height="20">
            <staticText><reportElement x="0" y="0" width="70" height="20" style="header"/><text><![CDATA[5.1) Tanque]]></text></staticText>
            <staticText><reportElement x="70" y="0" width="70" height="20" style="header"/><text><![CDATA[5.2) Bico]]></text></staticText>
            <staticText><reportElement x="140" y="0" width="120" height="20" style="header"/><text><![CDATA[5.3) Enc. Fechamento]]></text></staticText>
            <staticText><reportElement x="260" y="0" width="120" height="20" style="header"/><text><![CDATA[5.4) Enc. Abertura]]></text></staticText>
            <staticText><reportElement x="380" y="0" width="80" height="20" style="header"/><text><![CDATA[5.5) Aferições]]></text></staticText>
            <staticText><reportElement x="460" y="0" width="95" height="20" style="header"/><text><![CDATA[5.6) Vendas Bico]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField><reportElement x="0" y="0" width="70" height="18" style="cell"/><textFieldExpression><![CDATA[$F{bico.tanque.numero}]]></textFieldExpression></textField>
            <textField><reportElement x="70" y="0" width="70" height="18" style="cell"/><textFieldExpression><![CDATA[$F{bico.numero}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="140" y="0" width="120" height="18" style="num"/><textFieldExpression><![CDATA[$F{encerranteFechamento}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="260" y="0" width="120" height="18" style="num"/><textFieldExpression><![CDATA[$F{encerranteAbertura}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00' L'"><reportElement x="380" y="0" width="80" height="18" style="num"/><textFieldExpression><![CDATA[$F{afericoes}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00' L'"><reportElement x="460" y="0" width="95" height="18" style="num"/><textFieldExpression><![CDATA[$F{vendasBico}]]></textFieldExpression></textField>
        </band>
    </detail>

    <columnFooter>
        <band height="18">
            <staticText><reportElement x="365" y="0" width="95" height="18" style="header"/><text><![CDATA[5.7) Vendas no dia]]></text></staticText>
            <textField pattern="#,##0.00' L'"><reportElement x="460" y="0" width="95" height="18" style="num"/>
                <textFieldExpression><![CDATA[$V{TotalVendasBico} == null ? java.math.BigDecimal.ZERO : $V{TotalVendasBico}]]></textFieldExpression>
            </textField>
        </band>
    </columnFooter>
</jasperReport>
